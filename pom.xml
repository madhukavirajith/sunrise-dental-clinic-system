<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>lk.edu.icbt</groupId>
    <artifactId>sunrise-dental-clinic-system</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Sunrise Dental Clinic - Appointment and Patient Management System</name>
    <description>
        CIS6003 Advanced Programming (WRIT1) - Java EE web application built
        WITHOUT third-party frameworks (no Spring/Quarkus/etc), per assignment
        instructions. Only Java EE, a JDBC database driver, JUnit, and optional
        reporting/serialization dependencies are used.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- NOTE: Check which API your IntelliJ-generated Java EE project uses
             by default (javax.servlet.* vs jakarta.servlet.*) and align this
             version accordingly. jakarta.servlet is current for Tomcat 10+/
             Java EE 9+; javax.servlet is used on Tomcat 9 and older / classic
             Java EE 8. Swap the dependency below if IntelliJ generates the
             other namespace - it is a straight import find-replace. -->
        <servlet.api.version>6.0.0</servlet.api.version>
        <jsp.jstl.version>3.0.0</jsp.jstl.version>
        <junit.version>5.10.2</junit.version>
        <mysql.connector.version>8.3.0</mysql.connector.version>
    </properties>

    <dependencies>
        <!-- 1. Java EE dependency (Jakarta Servlet API) - provided by the
             application server (Tomcat/GlassFish) at runtime, so it is
             scope=provided and does not ship inside the WAR. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP + JSTL support (part of the Java EE web profile) -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>${jsp.jstl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>${jsp.jstl.version}</version>
        </dependency>

        <!-- 2. Database dependency (JDBC driver for MySQL via XAMPP/WAMPP) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- 3. JUnit dependency (unit testing / TDD, Task C) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 4. Serialization dependency (OPTIONAL) - only needed if you expose
             JSON from your web service endpoints. Remove if unused. -->
        <!--
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>sunrise-dental-clinic-system</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
